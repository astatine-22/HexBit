# HexBit environment variables — copy this file to .env.local and fill in the values.
# Restart `npm run dev` after changing .env.local.

# ---- Supabase ----
# Where: https://supabase.com/dashboard -> your project -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=          # "Project URL", e.g. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=     # "Project API keys" -> anon / publishable key (safe for browser reads)
SUPABASE_SERVICE_ROLE_KEY=         # "Project API keys" -> service_role key. SERVER-ONLY — used by pages/api/progress.js. Never prefix it with NEXT_PUBLIC_ and never commit .env.local.

# ---- Groq ----
# Where: https://console.groq.com/keys -> "Create API Key"
GROQ_API_KEY=                      # Used by pages/api/hint.js (model: llama-3.1-8b-instant)

# ---- Demo mode (optional) ----
# Set to "cache" to make pages/api/run.js skip Judge0 and serve the expected
# outputs from data/fallback.json for seeded challenges (live-demo safety net).
DEMO_MODE=
